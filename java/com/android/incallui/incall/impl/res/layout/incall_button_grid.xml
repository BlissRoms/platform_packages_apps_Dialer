<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/incall_button_sheet"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical"
  tools:showIn="@layout/frag_incall_voice">

  <LinearLayout
    android:id="@+id/incall_extra_buttons"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/incall_button_row_gap"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
      android:id="@+id/incall_extra_row_one"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_extra_button_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        tools:layout_height="@dimen/tools_button_height"/>

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_extra_button_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        tools:layout_height="@dimen/tools_button_height"/>

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_extra_button_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        tools:layout_height="@dimen/tools_button_height"/>

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_extra_button_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        tools:layout_height="@dimen/tools_button_height"/>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/incall_extra_row_two"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/incall_button_row_gap"
      android:orientation="horizontal">

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_extra_button_5"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        tools:layout_height="@dimen/tools_button_height"/>

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_extra_button_6"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        tools:layout_height="@dimen/tools_button_height"/>

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_extra_button_7"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        tools:layout_height="@dimen/tools_button_height"/>

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_extra_button_8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        tools:layout_height="@dimen/tools_button_height"/>
    </LinearLayout>
  </LinearLayout>

    <LinearLayout
      android:id="@+id/incall_button_row_one"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_first_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        app:incall_labelText="@string/incall_label_add_call"
        tools:layout_height="@dimen/tools_button_height"/>

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_second_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        app:incall_labelText="@string/incall_label_videocall"
        tools:layout_height="@dimen/tools_button_height"/>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/incall_button_row_two"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/incall_button_row_gap"
      android:orientation="horizontal">

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_third_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        app:incall_labelText="@string/incall_label_dialpad"
        tools:layout_height="@dimen/tools_button_height"/>

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_fourth_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        app:incall_labelText="@string/incall_label_mute"
        tools:layout_height="@dimen/tools_button_height"/>

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_fifth_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        app:incall_labelText="@string/incall_label_speaker"
        tools:layout_height="@dimen/tools_button_height"/>

      <com.android.incallui.incall.impl.CheckableLabeledButton
        android:id="@+id/incall_sixth_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:enabled="false"
        android:gravity="center"
        tools:layout_height="@dimen/tools_button_height"/>
    </LinearLayout>
</LinearLayout>
