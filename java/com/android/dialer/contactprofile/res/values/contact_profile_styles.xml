<resources>
  <style name="ContactProfile.TopButton" parent="">
    <item name="android:layout_width">@dimen/contact_profile_top_button_size</item>
    <item name="android:layout_height">@dimen/contact_profile_top_button_size</item>
    <item name="android:padding">@dimen/contact_profile_top_button_padding</item>
    <item name="android:background">@drawable/contact_profile_top_button_bg</item>
    <item name="android:scaleType">fitCenter</item>
    <item name="android:tint">?attr/dialerColorTextPrimary</item>
  </style>

  <style name="ContactProfile.ActionButton" parent="">
    <item name="android:layout_width">@dimen/contact_profile_action_size</item>
    <item name="android:layout_height">@dimen/contact_profile_action_size</item>
    <item name="android:layout_marginStart">@dimen/contact_profile_action_gap</item>
    <item name="android:background">@drawable/contact_profile_action_button_bg</item>
    <item name="android:scaleType">center</item>
    <item name="android:tint">?attr/dialerColorTextPrimary</item>
  </style>

  <style name="ContactProfile.SectionLabel" parent="">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:layout_marginTop">@dimen/dialer_space_section_gap</item>
    <item name="android:paddingStart">8dp</item>
    <item name="android:paddingEnd">8dp</item>
    <item name="android:paddingBottom">@dimen/dialer_space_control_gap</item>
    <item name="android:textAppearance">@style/TextAppearance.Dialer.Body.Description</item>
    <item name="android:textColor">?attr/dialerColorTextSecondary</item>
  </style>

  <style name="ContactProfile.SettingRow" parent="">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:padding">@dimen/dialer_space_page_inset</item>
    <item name="android:clipToOutline">true</item>
    <item name="android:foreground">?android:attr/selectableItemBackground</item>
    <item name="android:drawablePadding">@dimen/dialer_space_control_gap</item>
    <item name="android:drawableTint">?attr/dialerColorDestructiveText</item>
    <item name="android:gravity">center_vertical|start</item>
    <item name="android:textAppearance">@style/TextAppearance.Dialer.Body.Title</item>
    <item name="android:textColor">?attr/dialerColorDestructiveText</item>
  </style>

  <style name="ContactProfile.SettingRow.Neutral">
    <item name="android:drawableTint">?attr/dialerColorTextPrimary</item>
    <item name="android:textColor">?attr/dialerColorTextPrimary</item>
  </style>
</resources>
