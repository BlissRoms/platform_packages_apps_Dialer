<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/recents_screen_bg"
    android:orientation="horizontal">

  <RelativeLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="3">

    <!-- MainToolbar -->
    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_layout"/>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordinator_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbar"
        android:layout_alignParentBottom="true">

      <!-- Holds SpeedDial, Call Log, Contacts, Voicemail and Search fragments -->
      <FrameLayout
          android:id="@+id/fragment_container"
          android:layout_width="match_parent"
          android:layout_height="match_parent"/>

      <FrameLayout
          android:id="@+id/search_fragment_container"
          android:layout_width="match_parent"
          android:layout_height="match_parent"/>

      <com.android.dialer.widget.DialerFloatingActionButton
          android:id="@+id/fab"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="16dp"
          android:layout_marginTop="16dp"
          android:layout_marginEnd="@dimen/dialer_space_page_inset"
          android:layout_marginBottom="84dp"
          android:layout_gravity="end|bottom"
          android:forceDarkAllowed="false"
          android:src="@drawable/quantum_ic_dialpad_vd_theme_24"
          android:tint="@color/recents_fab_icon"
          app:tint="@color/recents_fab_icon"
          android:contentDescription="@string/dialpad_button_content_description"
          app:fabCustomSize="64dp"
          app:shapeAppearanceOverlay="@style/RecentsFabShape"
          app:backgroundTint="@color/recents_fab_bg"/>

      <include android:id="@+id/promotion_bottom_sheet"
          layout="@layout/promotion_bottom_sheet"/>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- BottomNavBar -->
    <include
        android:id="@+id/bottom_nav_bar"
        layout="@layout/bottom_nav_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"/>

    <!-- Host container for the contact tile drag shadow -->
    <FrameLayout
        android:id="@+id/activity_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
      <ImageView
          android:id="@+id/contact_tile_drag_shadow_overlay"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:importantForAccessibility="no"
          android:visibility="gone"/>
    </FrameLayout>
  </RelativeLayout>

  <FrameLayout
      android:id="@+id/dialpad_fragment_container"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="2"
      android:layout_marginStart="@dimen/dialer_space_control_gap"
      android:layout_marginTop="@dimen/dialer_space_page_inset"
      android:layout_marginEnd="@dimen/dialer_space_page_inset"
      android:layout_marginBottom="@dimen/dialer_space_page_inset"
      android:visibility="gone"/>

  <FrameLayout
      android:id="@+id/contact_profile_container"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="2"
      android:layout_marginStart="@dimen/dialer_space_control_gap"
      android:layout_marginTop="@dimen/dialer_space_page_inset"
      android:layout_marginEnd="@dimen/dialer_space_page_inset"
      android:layout_marginBottom="@dimen/dialer_space_page_inset"
      android:visibility="gone"/>
</LinearLayout>
