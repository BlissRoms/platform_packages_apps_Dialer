<resources>
  <style name="CallDetailsActionItemStyle" parent="Dialer.TextAppearance.Primary.Ellipsize">
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
    <item name="android:drawablePadding">17dp</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:minHeight">@dimen/call_details_action_height</item>
    <item name="android:padding">20dp</item>
    <item name="android:textSize">17sp</item>
    <item name="android:background">@drawable/call_details_row_surface</item>
    <item name="drawableTint">?attr/dialerColorTextSecondary</item>
  </style>

  <style name="CallDetailsActionItemStyle.Destructive">
    <item name="android:textColor">?attr/dialerColorDestructiveText</item>
    <item name="drawableTint">?attr/dialerColorDestructiveText</item>
  </style>

  <style name="RttTranscriptLink">
    <item name="android:fontFamily">@*android:string/config_headlineFontFamilyMedium</item>
    <item name="android:textColor">@color/dialer_link_color</item>
    <item name="android:textAllCaps">true</item>
    <item name="textAllCaps">true</item>
  </style>

  <style name="RttTranscriptMessage" parent="Dialer.TextAppearance.Secondary">
    <item name="android:fontFamily">@*android:string/config_bodyFontFamily</item>
    <item name="android:textAllCaps">false</item>
    <item name="textAllCaps">false</item>
  </style>
</resources>
