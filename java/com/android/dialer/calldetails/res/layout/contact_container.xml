<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/dialer_space_page_inset"
    android:paddingEnd="@dimen/dialer_space_page_inset"
    android:paddingTop="@dimen/dialer_space_page_inset"
    android:paddingBottom="@dimen/dialer_space_section_gap">

  <QuickContactBadge
      android:id="@+id/quick_contact_photo"
      android:layout_width="@dimen/call_details_contact_photo_size"
      android:layout_height="@dimen/call_details_contact_photo_size"
      android:focusable="true" />

  <com.android.dialer.widget.BidiTextView
      android:id="@+id/contact_name"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/dialer_space_section_gap"
      android:gravity="center_horizontal"
      android:textAppearance="@style/TextAppearance.Dialer.Heading.Caller" />

  <com.android.dialer.widget.BidiTextView
      android:id="@+id/phone_number"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/dialer_space_control_gap"
      android:gravity="center_horizontal"
      android:textAppearance="@style/TextAppearance.Dialer.Body.Description"
      android:textSize="17sp" />

  <TextView
      android:id="@+id/network"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center_horizontal"
      android:textAppearance="@style/TextAppearance.Dialer.Body.Description"
      android:visibility="gone" />

  <ImageView
      android:id="@+id/call_back_button"
      android:layout_width="@dimen/call_details_action_button_size"
      android:layout_height="@dimen/call_details_action_button_size"
      android:layout_marginTop="@dimen/dialer_space_section_gap"
      android:background="@drawable/call_details_action_button_bg"
      android:contentDescription="@string/call"
      android:scaleType="center"
      android:src="@drawable/quantum_ic_call_vd_theme_24"
      app:tint="?attr/dialerColorTextPrimary" />

  <LinearLayout
      android:id="@+id/assisted_dialing_container"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/dialer_space_section_gap"
      android:background="@drawable/dialer_card_single"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:padding="20dp">

    <ImageView
        android:id="@+id/assisted_dialing_globe"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/quantum_ic_language_vd_theme_24"
        app:tint="?attr/dialerColorTextSecondary" />

    <TextView
        android:id="@+id/assisted_dialing_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="17dp"
        android:textAppearance="@style/TextAppearance.Dialer.Body.Description" />
  </LinearLayout>

  <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/dialer_space_section_gap"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:text="@string/call_details_recent_activity"
      android:textAppearance="@style/TextAppearance.Dialer.Body.Description" />
</LinearLayout>
