<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dialer_space_page_inset"
    android:paddingEnd="@dimen/dialer_space_page_inset"
    android:orientation="vertical">

  <include layout="@layout/header"/>

  <LinearLayout
      android:id="@+id/click_target"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="@dimen/contact_row_min_height"
      android:padding="@dimen/dialer_space_page_inset"
      android:backgroundTint="@color/contact_row_background"
      android:clipToOutline="true"
      android:foreground="?android:attr/selectableItemBackground"
      android:gravity="center_vertical"
      android:orientation="horizontal">

    <QuickContactBadge
        android:id="@+id/photo"
        android:layout_width="@dimen/photo_size"
        android:layout_height="@dimen/photo_size"
        android:clickable="false"
        android:focusable="false" />

    <com.android.dialer.widget.BidiTextView
        android:id="@+id/contact_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dialer_space_control_gap"
        android:layout_marginEnd="@dimen/dialer_space_control_gap"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Dialer.Body.Title"/>

    <ImageButton
        android:id="@+id/call_button"
        android:layout_width="@dimen/dialer_touch_target_min_size"
        android:layout_height="@dimen/dialer_touch_target_min_size"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:scaleType="center"
        android:src="@drawable/quantum_ic_call_vd_theme_24"
        android:tint="?attr/dialerColorTextSecondary"/>
  </LinearLayout>
</LinearLayout>
