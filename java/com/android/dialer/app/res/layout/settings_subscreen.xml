<!-- Host layout for settings sub-screens: a custom header matching the redesigned root, with the
     legacy preference fragment hosted in @id/sub_content. Replaces the system ActionBar so there is
     no header flash on back and the sub-screens match the card aesthetic. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/dialerColorCanvas">

  <include layout="@layout/settings_header" />

  <FrameLayout
      android:id="@+id/sub_content"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"/>
</LinearLayout>
