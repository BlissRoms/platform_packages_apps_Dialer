<!-- Card-styled preference row used by the redesigned settings preference theme. Only framework
     view ids are used so androidx PreferenceFragmentCompat binds title/summary/widget correctly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="20dp"
    android:layout_marginEnd="20dp"
    android:layout_marginBottom="8dp"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/recents_row_card_bg"
    android:foreground="?android:attr/selectableItemBackground"
    android:clipToOutline="true"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/recents_name_text"
        android:textSize="16sp"
        android:ellipsize="marquee"/>

    <TextView
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/recents_subtitle_text"
        android:textSize="14sp"/>
  </LinearLayout>

  <FrameLayout
      android:id="@android:id/widget_frame"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="12dp"
      android:gravity="center_vertical"
      android:orientation="vertical"/>
</LinearLayout>
