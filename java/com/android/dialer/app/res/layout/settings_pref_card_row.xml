<!-- Card-styled preference row used by the redesigned settings preference theme. Only framework
     view ids are used so androidx PreferenceFragmentCompat binds title/summary/widget correctly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/dialer_space_page_inset"
    android:layout_marginEnd="@dimen/dialer_space_page_inset"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="20dp">

  <FrameLayout
      android:id="@android:id/icon_frame"
      android:layout_width="44dp"
      android:layout_height="44dp"
      android:layout_marginEnd="17dp">

    <ImageView
        android:id="@android:id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:tint="?attr/dialerColorTextPrimary" />
  </FrameLayout>

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:orientation="vertical">

    <TextView
        android:id="@android:id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Dialer.Body.Title" />

    <TextView
        android:id="@android:id/summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.Dialer.Body.Description" />
  </LinearLayout>

  <FrameLayout
      android:id="@android:id/widget_frame"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="17dp"
      android:gravity="center_vertical" />
</LinearLayout>
