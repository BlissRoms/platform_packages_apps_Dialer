<!-- Layout parameters are set programmatically. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/call_log_fragment_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical">

  <LinearLayout
      android:id="@+id/call_log_selection_header"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingStart="@dimen/call_log_horizontal_margin"
      android:paddingEnd="@dimen/call_log_horizontal_margin"
      android:paddingTop="@dimen/dialer_space_page_inset"
      android:paddingBottom="@dimen/dialer_space_control_gap"
      android:orientation="vertical"
      android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <ImageButton
          android:id="@+id/selection_close"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:background="@drawable/settings_back_circle"
          android:foreground="?android:attr/selectableItemBackgroundBorderless"
          android:src="@drawable/quantum_ic_close_vd_theme_24"
          android:tint="?attr/dialerColorTextPrimary"
          android:scaleType="centerInside"
          android:contentDescription="@string/call_log_selection_close" />

      <TextView
          android:id="@+id/selection_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="17dp"
          android:layout_marginEnd="17dp"
          android:accessibilityLiveRegion="polite"
          android:maxLines="1"
          android:ellipsize="end"
          android:textAppearance="@style/TextAppearance.Dialer.Heading.Page" />

      <ImageButton
          android:id="@+id/selection_delete"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:background="@drawable/settings_back_circle"
          android:foreground="?android:attr/selectableItemBackgroundBorderless"
          android:src="@drawable/quantum_ic_delete_vd_theme_24"
          android:tint="?attr/dialerColorDestructiveText"
          android:scaleType="centerInside"
          android:contentDescription="@string/delete" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dialer_space_section_gap"
        android:background="@drawable/dialer_card_clip_single"
        android:clipToOutline="true">

      <LinearLayout
          android:id="@+id/select_all_row"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:minHeight="56dp"
          android:paddingStart="@dimen/call_log_start_margin"
          android:paddingEnd="@dimen/call_log_outer_margin"
          android:background="@drawable/recents_row_surface"
          android:gravity="center_vertical"
          android:orientation="horizontal">

        <CheckBox
            android:id="@+id/select_all_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@null"
            android:button="@drawable/call_log_select_all_check"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dialer_space_page_inset"
            android:text="@string/select_all"
            android:textAppearance="@style/TextAppearance.Dialer.Body.Title" />
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>

  <FrameLayout
    android:id="@+id/modal_message_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone"/>

  <!-- Filter chips. Only shown on the main Recents screen (hidden in CallLogActivity and the
       voicemail fragment). Wired in CallLogFragment.setupView. -->
  <HorizontalScrollView
    android:id="@+id/chip_filter_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:overScrollMode="never"
    android:clipToPadding="false"
    android:paddingStart="@dimen/call_log_horizontal_margin"
    android:paddingEnd="@dimen/call_log_horizontal_margin"
    android:paddingTop="4dp"
    android:paddingBottom="6dp">

    <LinearLayout
      android:id="@+id/chip_filter_row"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

      <TextView
        style="@style/Recents.Chip"
        android:id="@+id/chip_all"
        android:text="@string/call_log_all_title"/>

      <TextView
        style="@style/Recents.Chip"
        android:id="@+id/chip_missed"
        android:text="@string/call_log_missed_title"/>

      <TextView
        style="@style/Recents.Chip"
        android:id="@+id/chip_spam"
        android:text="@string/recents_chip_spam"/>

      <TextView
        style="@style/Recents.Chip"
        android:id="@+id/chip_customize"
        android:drawableStart="@drawable/recents_ic_gear"
        android:drawablePadding="6dp"
        android:text="@string/recents_chip_customize"/>
    </LinearLayout>
  </HorizontalScrollView>

  <androidx.recyclerview.widget.RecyclerView
    android:id="@+id/recycler_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/floating_action_button_list_bottom_padding"
    android:paddingStart="@dimen/call_log_horizontal_margin"
    android:paddingEnd="@dimen/call_log_horizontal_margin"
    android:clipToPadding="false"/>

  <com.android.dialer.widget.EmptyContentView
    android:id="@+id/empty_list_view"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:layout_gravity="center"
    android:gravity="center_vertical"/>

</LinearLayout>
